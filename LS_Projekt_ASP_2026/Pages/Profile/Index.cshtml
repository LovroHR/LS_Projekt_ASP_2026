@page
@model LS_Projekt_ASP_2026.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Moj profil";
}

<div class="container mt-4 page-shell">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold" style="font-size: var(--fs-h1); color: var(--text-primary);">Moj profil</h1>
            <p class="text-muted fw-normal" style="font-size: var(--fs-body-sm); color: var(--text-secondary);">Uredi podatke svog korisnickog racuna</p>
        </div>
        <div class="col-md-4 text-md-end">
            <span class="badge bg-info">@Model.Role</span>
        </div>
    </div>

    <form method="post" class="row g-3">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="col-md-6">
            <label class="form-label">Username</label>
            <input asp-for="Input.UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.UserName" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Ime</label>
            <input asp-for="Input.Name" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="Input.Name" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Prezime</label>
            <input asp-for="Input.Surname" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="Input.Surname" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Telefon</label>
            <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Datum rodenja</label>
            <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
            <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Adresa</label>
            <input asp-for="Input.Address" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="Input.Address" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Drzava</label>
            <input asp-for="Input.Country" class="form-control" autocomplete="country-name" />
            <span asp-validation-for="Input.Country" class="text-danger small"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Spremi promjene</button>
            <a class="btn btn-secondary" asp-page="/Index">Nazad</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
