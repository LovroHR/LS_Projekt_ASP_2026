@page
@model LS_Projekt_ASP_2026.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Admin panel";
}

<div class="container-fluid mt-4 page-shell">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold" style="font-size: var(--fs-h1); color: var(--text-primary);">Admin panel</h1>
            <p class="text-muted fw-normal" style="font-size: var(--fs-body-sm); color: var(--text-secondary);">Upravljanje korisnicima i rolama</p>
        </div>
    </div>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input asp-for="Q" class="form-control" placeholder="Pretrazi po imenu, prezimenu ili emailu..." />
            <button class="btn btn-primary" type="submit">Pretrazi</button>
            <a class="btn btn-outline-secondary" asp-page="/Admin/Users">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ime</th>
                    <th>Email</th>
                    <th>Telefon</th>
                    <th>Rola</th>
                    <th>Poslovni ID</th>
                    <th style="width: 220px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var formId = $"user-update-{user.IdentityUserId}";
                    <tr>
                        <td>
                            <input type="hidden" form="@formId" name="Input.IdentityUserId" value="@user.IdentityUserId" />
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <input form="@formId" name="Input.Name" value="@user.Name" class="form-control form-control-sm" placeholder="Ime" />
                                </div>
                                <div class="col-md-6">
                                    <input form="@formId" name="Input.Surname" value="@user.Surname" class="form-control form-control-sm" placeholder="Prezime" />
                                </div>
                            </div>
                        </td>
                        <td>
                            <input form="@formId" name="Input.Email" value="@user.Email" class="form-control form-control-sm" />
                        </td>
                        <td>
                            <input form="@formId" name="Input.PhoneNumber" value="@user.PhoneNumber" class="form-control form-control-sm" />
                        </td>
                        <td>
                            <select form="@formId" name="Input.Role" class="form-select form-select-sm">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role" selected="@(role == user.Role)">@role</option>
                                }
                            </select>
                        </td>
                        <td>@(user.BusinessUserId?.ToString() ?? "-")</td>
                        <td class="text-end">
                            <form id="@formId" method="post" asp-page-handler="Update"></form>
                            <button form="@formId" type="submit" class="btn btn-sm btn-primary">Spremi</button>
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Delete" asp-route-id="@user.IdentityUserId" onsubmit="return confirm('Obrisati korisnika @user.Email?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@user.IsCurrentUser">Obrisi</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="text-center py-5">
            <h3>Nema korisnika</h3>
            <p class="text-muted">Nema rezultata za zadanu pretragu.</p>
        </div>
    }
</div>
